---
interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
const navItems = [
  { name: 'Home', path: '/' },
  { name: 'Tickets', path: '/tickets/' },
  { name: 'Virtual Entertainment', path: '/virtual-entertainment/' },
  { name: 'Our Show Gallery', path: '/gallery/' },
  { name: 'About Us', path: '/about-us/' },
  { name: 'Join Us', path: '/join-us/' },
  { name: 'Contact Us', path: '/contact-us/' },
  { name: 'Auditions', path: '/auditions/' },
];
---

<nav class="bg-primary text-white shadow-md">
  <div class="container mx-auto px-4">
    <div class="flex justify-between items-center py-4">
      <a href="/" class="text-2xl font-serif font-bold hover:text-secondary transition-colors">
        CT Gilbert & Sullivan
      </a>

      <div class="hidden md:flex space-x-2">
        {navItems.map(({ name, path }) => (
          <a
            href={path}
            class={`px-3 py-2 rounded-md text-sm font-medium transition-colors ${
              currentPath === path || (currentPath?.startsWith(path) && path !== '/')
                ? 'bg-secondary text-primary'
                : 'hover:bg-blue-800'
            }`}
          >
            {name}
          </a>
        ))}
      </div>

      <div class="md:hidden">
        <button
          id="menu-toggle"
          class="flex items-center px-3 py-2 rounded-md hover:bg-blue-800 transition-colors"
          aria-label="Toggle menu"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              strokeLinecap="round"
              strokeLinejoin="round"
              strokeWidth={2}
              d="M4 6h16M4 12h16M4 18h16"
            />
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden md:hidden pb-4">
      {navItems.map(({ name, path }) => (
        <a
          href={path}
          class="block px-3 py-2 rounded-md text-base font-medium hover:bg-blue-800 transition-colors"
        >
          {name}
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  document.getElementById('menu-toggle').addEventListener('click', function() {
    const menu = document.getElementById('mobile-menu');
    menu.classList.toggle('hidden');
  });
</script>
