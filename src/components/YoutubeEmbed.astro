---
interface Props {
  type: 'playlist' | 'video' | 'shorts';
  playlistId?: string;
  videoId?: string;
  title?: string;
}

const { type, playlistId, videoId, title = 'YouTube Video' } = Astro.props;

let embedUrl;
if (type === 'playlist' && playlistId) {
  embedUrl = `https://www.youtube.com/embed/videoseries?list=${playlistId}`;
} else if (type === 'video' && videoId) {
  embedUrl = `https://www.youtube.com/embed/${videoId}`;
} else if (type === 'shorts') {
  embedUrl = `https://www.youtube.com/embed?listType=user_uploads&list=@connecticutgilbertsullivan2348&feature=sh`;
} else {
  embedUrl = '';
}
---

<div class="aspect-video bg-black rounded-lg overflow-hidden">
  <iframe
    class="w-full h-full rounded-lg"
    src={embedUrl}
    title={title}
    frameborder="0"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen
  ></iframe>
</div>
