---
interface Props {
  id: string;
  title: string;
  description: string;
  thumbnails: {
    default?: { url: string; width: number; height: number };
    medium?: { url: string; width: number; height: number };
    high?: { url: string; width: number; height: number };
  };
  publishedAt?: string;
}

const { id, title, description, thumbnails, publishedAt } = Astro.props;

const thumbnailUrl = thumbnails.medium?.url || thumbnails.default?.url || '';

const publishedDate = publishedAt ? new Date(publishedAt) : new Date();
const dateOptions: Intl.DateTimeFormatOptions = { month: 'short', day: 'numeric', year: 'numeric' };
---

<div class="card text-center">
  <div class="aspect-video mb-4 overflow-hidden rounded-lg">
    <a href={`https://youtu.be/${id}`} target="_blank" rel="noopener noreferrer">
      <img
        src={thumbnailUrl}
        alt={title}
        class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
      />
    </a>
  </div>
  <h3 class="text-lg font-bold mb-2 line-clamp-2">{title}</h3>
  <p class="text-gray-600 text-sm mb-2">{publishedDate.toLocaleDateString('en-US', dateOptions)}</p>
  <p class="text-gray-500 text-sm mb-4 line-clamp-2">{description}</p>
  <a href={`https://youtu.be/${id}`} target="_blank" class="inline-flex items-center gap-2 text-primary hover:underline">
    <svg
      class="w-5 h-5"
      fill="currentColor"
      viewBox="0 0 24 24"
    >
      <path d="M8 5v14l11-7z" />
    </svg>
    Watch on YouTube
  </a>
</div>
