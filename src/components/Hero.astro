---
---

<section class="relative bg-gray-800 text-white overflow-hidden">
  <div class="absolute inset-0">
    <div class="absolute inset-0 bg-gradient-to-r from-primary/90 to-secondary/90 mix-blend-multiply"></div>
    <img
      src="/images/hero-placeholder.jpg"
      alt="Theater Performance"
      class="w-full h-full object-cover opacity-50"
    />
  </div>
  <div class="relative container mx-auto px-4 py-24 lg:py-32">
    <div class="max-w-3xl">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif font-bold mb-6 leading-tight">
        The Connecticut Gilbert & Sullivan Society
      </h1>
      <p class="text-xl md:text-2xl mb-8 text-gray-200">
        Presenting <strong>The Pirates of Penzance</strong>
        <br />
        <span class="text-secondary">October 17-18, 2026</span>
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="/tickets/" class="btn-primary text-center">
          Get Tickets
        </a>
        <a href="/about-us/" class="btn-secondary text-center">
          Learn More
        </a>
      </div>
    </div>
  </div>
</section>
