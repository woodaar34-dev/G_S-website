---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import YoutubeSubscribe from '../components/YoutubeSubscribe.astro';
---

<Layout>
  <Navbar currentPath="/virtual-entertainment/" />

  <main>
    <section class="container mx-auto px-4 py-16">
      <div class="max-w-5xl mx-auto">
        <h1 class="text-4xl font-serif font-bold mb-8 text-center">Virtual Entertainment</h1>

        <div class="card mb-8">
          <h2 class="text-2xl font-serif font-bold mb-4">Watch Our Channel</h2>
          <p class="mb-6">
            If you can't make it to the theater, enjoy our performances from home!
            Subscribe to our YouTube channel for video highlights, full-length recordings,
            and exclusive behind-the-scenes content.
          </p>

          <div class="aspect-video bg-black rounded-lg overflow-hidden mb-6">
            <iframe
              class="w-full h-full rounded-lg"
              src="https://www.youtube.com/embed/videoseries?list=UUpy6NB5QxjnMy_kNg7R2Q4w7V-KJaubMx"
              title="Connecticut Gilbert & Sullivan Society Channel"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>

          <div class="text-center">
            <YoutubeSubscribe />
          </div>
        </div>

        <div class="card mb-8">
          <h2 class="text-2xl font-serif font-bold mb-4">Featured Performances</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="card text-center">
              <div class="aspect-video mb-4 overflow-hidden rounded-lg">
                <iframe
                  class="w-full h-full rounded-lg"
                  src="https://www.youtube.com/embed/IAWAdkbXdag"
                  title="The Pirates of Penzance (2016)"
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
              <h3 class="text-lg font-bold mb-2">The Pirates of Penzance (2016)</h3>
              <p class="text-gray-600 mb-4">Full-length performance from 2016</p>
              <a href="https://youtu.be/IAWAdkbXdag" target="_blank" class="inline-flex items-center gap-2 text-primary hover:underline">
                <svg
                  class="w-5 h-5"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path d="M8 5v14l11-7z" />
                </svg>
                Watch on YouTube
              </a>
            </div>
            <div class="card text-center">
              <div class="aspect-video mb-4 overflow-hidden rounded-lg">
                <iframe
                  class="w-full h-full rounded-lg"
                  src="https://www.youtube.com/embed/videoseries?list=PLpy6NB5QxjnMy_kNg7R2Q4w7V-KJaubMx"
                  title="Iolanthe (2024)"
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
              <h3 class="text-lg font-bold mb-2">Iolanthe (2024)</h3>
              <p class="text-gray-600 mb-4">Select performances available</p>
              <a href="/virtual-entertainment" class="inline-flex items-center gap-2 btn-primary">
                View All Iolanthe Videos
              </a>
            </div>
          </div>
        </div>

        <div class="card mb-8">
          <h2 class="text-2xl font-serif font-bold mb-4">Order Video Recordings</h2>
          <div class="prose max-w-none">
            <p class="mb-4">
              <strong>UNABLE TO MAKE THE SHOW?</strong>
            </p>
            <p class="mb-6">
              Order a video recording of our performances and enjoy them from the comfort
              of your home. Perfect for those who couldn't attend or want to relive the experience.
            </p>
            <div class="bg-blue-50 p-6 rounded-lg mb-6">
              <h3 class="text-xl font-bold mb-4">Currently Available: Iolanthe</h3>
              <p class="mb-4">
                Click
                <a href="/videos/iolanthe-order" class="text-primary hover:underline font-semibold">
                  HERE
                </a>
                to order a video of the Saturday matinee and/or Saturday evening performance of Iolanthe.
              </p>
              <p class="text-sm text-gray-600">
                PDF Order Form • Includes Streaming and Physical DVD Options
              </p>
            </div>
          </div>
        </div>

        <div class="card">
          <h2 class="text-2xl font-serif font-bold mb-4">Can't Find What You're Looking For?</h2>
          <p class="mb-6">
            Contact us at 860-554-1256 or jfreedman@snet.net to inquire about
            video availability for other productions.
          </p>
          <p class="font-semibold text-secondary">
            We're constantly adding more performances to our library!
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
