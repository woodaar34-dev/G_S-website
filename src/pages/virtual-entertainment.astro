---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import YoutubeSubscribe from '../components/YoutubeSubscribe.astro';
import { getPlaylistVideos, getYoutubeShorts } from '../lib/youtube';
import YoutubeVideoCard from '../components/YoutubeVideoCard.astro';
import YoutubeShortsGrid from '../components/YoutubeShortsGrid.astro';

const latestVideoPlaylistId = 'PLpy6NB5QxjnMAl1dwoMpLVMiRAHOOEx-7';
const featuredPlaylistId = 'PLpy6NB5QxjnMAl1dwoMpLVMiRAHOOEx-7';
const shortsChannelId = 'UCPirOpb_2Rei1SzcbtxId6Q';

let latestVideo = null;
let featuredVideos = [];
let shorts = [];
let errorMessage = '';

try {
  const latest = await getPlaylistVideos(latestVideoPlaylistId, 1);
  latestVideo = latest.length > 0 ? latest[0] : null;
  featuredVideos = await getPlaylistVideos(featuredPlaylistId, 6);
  shorts = await getYoutubeShorts(shortsChannelId, 6);
} catch (error) {
  errorMessage = 'Error loading videos';
}
---

<Layout>
  <Navbar currentPath="/virtual-entertainment/" />

  <main>
    <section class="container mx-auto px-4 py-16">
      <div class="max-w-5xl mx-auto">
        <h1 class="text-4xl font-serif font-bold mb-8 text-center">Virtual Entertainment</h1>

        <div class="card mb-8">
          <h2 class="text-2xl font-serif font-bold mb-4">Watch Our Channel</h2>
          <p class="mb-6">
            If you can't make it to the theater, enjoy our performances from home!
            Subscribe to our YouTube channel for video highlights, full-length recordings,
            and exclusive behind-the-scenes content.
          </p>

          <div class="aspect-video bg-black rounded-lg overflow-hidden mb-6">
            {latestVideo ? (
              <img
                src={latestVideo.thumbnails.medium?.url || latestVideo.thumbnails.default?.url}
                alt={latestVideo.title}
                class="w-full h-full object-cover"
              />
            ) : (
              <div class="flex items-center justify-center h-full text-white">
                {errorMessage || 'Loading latest video...'}
              </div>
            )}
          </div>

          <div class="text-center">
            <YoutubeSubscribe />
          </div>
        </div>

        <div class="card mb-8">
          <h2 class="text-2xl font-serif font-bold mb-4">Featured Performances</h2>
          {featuredVideos.length > 0 ? (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {featuredVideos.map((video: any) => (
                <YoutubeVideoCard
                  id={video.id}
                  title={video.title}
                  description={video.description || ''}
                  thumbnails={video.thumbnails}
                  publishedAt={video.publishedAt}
                />
              ))}
            </div>
          ) : (
            <div class="text-center text-gray-500 py-8">
              {errorMessage || 'No videos available'}
            </div>
          )}
        </div>

        <div class="card mb-8">
          <h2 class="text-2xl font-serif font-bold mb-4">Behind the Scenes</h2>
          <p class="mb-6">
            Watch our shortest and most entertaining moments from rehearsals, behind-the-scenes, and more!
          </p>
          <div class="mb-6">
            {shorts.length > 0 ? (
              <YoutubeShortsGrid shorts={shorts} />
            ) : (
              <div class="text-center text-gray-500 py-8">
                {errorMessage || 'No shorts available'}
              </div>
            )}
          </div>
          <div class="text-center">
            <a href={`https://www.youtube.com/@connecticutgilbertsullivan2348/shorts`} target="_blank" class="inline-flex items-center gap-2 btn-primary">
              <svg
                class="w-5 h-5"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path d="M13 3a9 9 0 1 0 9 9 9 9 0 0 0-9-9zm0 16a7 7 0 1 1 7-7 7 7 0 0 1-7 7zm-1-9a1 1 0 0 0-1 1v4.25l3.5 2.1a1 1 0 0 0 1.5-1.1V8a1 1 0 0 0-1-1z" />
              </svg>
              View All Shorts on YouTube
            </a>
          </div>
        </div>

        <div class="card">
          <h2 class="text-2xl font-serif font-bold mb-4">Can't Find What You're Looking For?</h2>
          <p class="mb-6">
            Contact us at 860-554-1256 or jfreedman@snet.net to inquire about
            video availability for other productions.
          </p>
          <p class="font-semibold text-secondary">
            We're constantly adding more performances to our library!
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
