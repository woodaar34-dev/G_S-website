---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Navbar currentPath="/contact-us/" />

  <main>
    <section class="container mx-auto px-4 py-16">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl font-serif font-bold mb-8 text-center">Contact Us</h1>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div>
            <div class="card mb-6">
              <h2 class="text-2xl font-serif font-bold mb-4">Get in Touch</h2>
              <p class="mb-6">
                We'd love to hear from you! Whether you have questions about tickets,
                auditions, membership, or sponsorships, our team is here to help.
              </p>

              <div class="space-y-4">
                <div class="flex items-start gap-3">
                  <svg
                    class="w-6 h-6 text-primary mt-1"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      strokeLinecap="round"
                      strokeLinejoin="round"
                      strokeWidth={2}
                      d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                    />
                  </svg>
                  <div>
                    <p class="font-semibold">Email</p>
                    <p class="text-secondary">jfreedman@snet.net</p>
                    <p class="text-sm text-gray-500">We typically respond within 24-48 hours</p>
                  </div>
                </div>

                <div class="flex items-start gap-3">
                  <svg
                    class="w-6 h-6 text-primary mt-1"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      strokeLinecap="round"
                      strokeLinejoin="round"
                      strokeWidth={2}
                      d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                    />
                  </svg>
                  <div>
                    <p class="font-semibold">Phone</p>
                    <p class="text-secondary">860-554-1256</p>
                    <p class="text-sm text-gray-500">Available during business hours</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="card">
              <h2 class="text-2xl font-serif font-bold mb-4">Our Location</h2>
              <div class="prose max-w-none">
                <p class="mb-2"><strong>Valley Regional High School</strong></p>
                <p class="mb-2">256 Kelsey Hill Road</p>
                <p class="mb-4">Deep River, CT 06417</p>
                <a href="/theatre" class="inline-flex items-center gap-2 text-primary hover:underline">
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      strokeLinecap="round"
                      strokeLinejoin="round"
                      strokeWidth={2}
                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                    />
                    <path
                      strokeLinecap="round"
                      strokeLinejoin="round"
                      strokeWidth={2}
                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                    />
                  </svg>
                  View on Google Maps
                </a>
              </div>
            </div>
          </div>

          <div>
            <div class="card">
              <h2 class="text-2xl font-serif font-bold mb-4">Send Us a Message</h2>
              <form
                action="https://formspree.io/f/your-form-id"
                method="POST"
                class="space-y-4"
              >
                <div>
                  <label for="name" class="block text-sm font-medium mb-1">Name</label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    class="w-full p-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary"
                    placeholder="Your name"
                  />
                </div>

                <div>
                  <label for="email" class="block text-sm font-medium mb-1">Email</label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    class="w-full p-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary"
                    placeholder="your.email@example.com"
                  />
                </div>

                <div>
                  <label for="subject" class="block text-sm font-medium mb-1">Subject</label>
                  <select
                    id="subject"
                    name="subject"
                    class="w-full p-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary"
                  >
                    <option value="tickets">Ticket Information</option>
                    <option value="auditions">Auditions & Casting</option>
                    <option value="membership">Membership</option>
                    <option value="sponsors">Sponsorship</option>
                    <option value="general">General Inquiry</option>
                    <option value="other">Other</option>
                  </select>
                </div>

                <div>
                  <label for="message" class="block text-sm font-medium mb-1">Message</label>
                  <textarea
                    id="message"
                    name="message"
                    rows="5"
                    required
                    class="w-full p-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary"
                    placeholder="How can we help you?"
                  ></textarea>
                </div>

                <button
                  type="submit"
                  class="w-full bg-primary text-white font-semibold py-2 px-4 rounded hover:bg-blue-800 transition-colors"
                >
                  Send Message
                </button>
              </form>

              <div class="mt-6 p-4 bg-blue-50 rounded-lg">
                <p class="text-sm text-gray-600">
                  <strong>Prefer to call?</strong> Our phone number is
                  <a href="tel:860-554-1256" class="text-primary hover:underline ml-1">
                    860-554-1256
                  </a>
                  .
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="card mt-8">
          <h2 class="text-2xl font-serif font-bold mb-4">Connect With Us</h2>
          <div class="display flex flex-wrap gap-4">
            <a href="https://www.youtube.com/@connecticutgilbertsullivan2348" class="flex items-center gap-2 p-3 rounded-lg hover:bg-blue-50 transition-colors">
              <svg
                class="w-8 h-8"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.376.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.376-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.498-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
              </svg>
              <span class="font-medium">YouTube Channel</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
